# Supabase-only SQLite mirror (Drizzle schema: domain + platform tables + auth_sessions)
# Use ephemeral runtime path; source of truth is remote object in Supabase Storage.
DATABASE_URL=file:/tmp/nutricare.db
SQLITE_STORAGE_SYNC=1
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...   # server only — never expose to the client
SQLITE_STORAGE_BUCKET=media
SQLITE_STORAGE_OBJECT_PATH=nutricare.sqlite
# Optional one-time bootstrap when remote object does not exist yet:
# SQLITE_STORAGE_BOOTSTRAP=1

# Optional local development mode (explicit opt-in; development only):
# ALLOW_LOCAL_DEV_SQLITE=1
# ALLOW_LOCAL_DEV_FILE_STORAGE=1
# DATABASE_URL=file:local.db
# FILE_STORAGE_PROVIDER=local

# Server (e.g. Render): after migrations, if the `users` table is empty the app runs `npm run db:seed`
# once per process (dietitian + one patient + meal catalog). Set to disable:
# SKIP_DB_SEED=1
# To force re-seed even when users already exist:
# RUN_DB_SEED_ON_START=1

# Optional seeded users (dietitian + patient) used by scripts/seed-dev-user.ts and scripts/seed-patients.ts.
# Seeded dietitian account (used by scripts/seed-dev-user.ts and as patient owner in scripts/seed-patients.ts)
# SEED_DIETITIAN_NAME=Dietitian
# SEED_DIETITIAN_EMAIL=dietitian@example.com
# SEED_DIETITIAN_USERNAME=dietitian
# SEED_DIETITIAN_PHONE=+10000000000
# SEED_DIETITIAN_PASSWORD=password
# Optional organization for the seeded users
# SEED_ORG_NAME=NutriCare Organization
# SEED_ORG_TYPE=clinic
#
# Seeded patient account (scripts/seed-patients.ts)
# SEED_PATIENT_NAME=Patient
# SEED_PATIENT_EMAIL=patient@example.com
# SEED_PATIENT_USERNAME=patient
# SEED_PATIENT_PHONE=
# SEED_PATIENT_PASSWORD=password

# Optional: full demo meal-plan journey (not run by db:seed — manual only):
# npm run db:seed-demo-journey
# DEMO_DIETITIAN_EMAIL / DEMO_DIETITIAN_PASSWORD / DEMO_PATIENT_PASSWORD — see scripts/seed-demo-dietitian-journey.ts

# Supabase object storage for food/recipe images (no local fallback)
# FILE_STORAGE_PROVIDER=supabase
# SUPABASE_STORAGE_BUCKET=media
# Verify pull/push (uses SUPABASE_* from .env; pass SQLITE_STORAGE_* on the command line if not in .env):
# SQLITE_STORAGE_SYNC=1 SQLITE_STORAGE_BUCKET=media npm run db:test-storage-sync

# Registration email (Resend). In development, OTP is logged if unset; in production it is required.
# RESEND_API_KEY=re_...
# EMAIL_FROM=NutriCare <onboarding@resend.dev>

# AI meal plans & recipes (OpenAI Chat Completions, default model gpt-5.4)
# OPENAI_API_KEY=sk-...
# Optional overrides:
# OPENAI_MODEL=gpt-5.4
# OPENAI_BASE_URL=https://api.openai.com/v1

# Edamam food database (optional — get free keys at developer.edamam.com)
# EDAMAM_APP_ID=your_id
# EDAMAM_APP_KEY=your_key
