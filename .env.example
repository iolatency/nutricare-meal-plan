# Pure SQLite (Drizzle schema: domain + platform tables + auth_sessions)
DATABASE_URL=file:local.db

# Server (e.g. Render): after migrations, if the `users` table is empty the app runs `npm run db:seed`
# once per process (dietitian + one patient + meal catalog). Set to disable:
# SKIP_DB_SEED=1
# To force re-seed even when users already exist:
# RUN_DB_SEED_ON_START=1

# Optional: first patient row (scripts/seed-patients.ts). Dietitian stays scripts/seed-dev-user.ts (dev@example.com).
# SEED_PATIENT_NAME=Patient
# SEED_PATIENT_EMAIL=patient@example.com
# SEED_PATIENT_USERNAME=patient
# SEED_PATIENT_PHONE=
# SEED_PATIENT_PASSWORD=password

# Optional: full demo meal-plan journey (not run by db:seed — manual only):
# npm run db:seed-demo-journey
# DEMO_DIETITIAN_EMAIL / DEMO_DIETITIAN_PASSWORD / DEMO_PATIENT_PASSWORD — see scripts/seed-demo-dietitian-journey.ts

# Optional: mirror the SQLite file to a Supabase Storage bucket (e.g. bucket "media").
# On server start the file is downloaded if present; after each HTTP request it is re-uploaded.
# Use a writable path on serverless (e.g. Vercel): DATABASE_URL=file:/tmp/nutricare.db
# SQLITE_STORAGE_SYNC=1
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbG...   # server only — never expose to the client
# SQLITE_STORAGE_BUCKET=media
# SQLITE_STORAGE_OBJECT_PATH=nutricare.sqlite
# Verify pull/push (uses SUPABASE_* from .env; pass SQLITE_STORAGE_* on the command line if not in .env):
# SQLITE_STORAGE_SYNC=1 SQLITE_STORAGE_BUCKET=media npm run db:test-storage-sync

# Registration email (Resend). In development, OTP is logged if unset; in production it is required.
# RESEND_API_KEY=re_...
# EMAIL_FROM=NutriCare <onboarding@resend.dev>

# AI recipe generation (DeepSeek)
# DEEPSEEK_API_KEY=sk-...

# Edamam food database (optional — get free keys at developer.edamam.com)
# EDAMAM_APP_ID=your_id
# EDAMAM_APP_KEY=your_key
