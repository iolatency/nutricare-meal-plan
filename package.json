{
	"name": "nutricare-meal-plan",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "NutriCare meal planning — SvelteKit, Drizzle, SQLite",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"postinstall": "node scripts/ensure-uuid-cjs-shim.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:push": "drizzle-kit push",
		"db:push:force": "drizzle-kit push --force",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed-dev-user": "tsx scripts/seed-dev-user.ts",
		"db:seed-meal": "tsx scripts/seed-meal-domain.ts",
		"db:patch-v2": "tsx scripts/patch-supplements-v2.ts",
		"db:import-v0": "tsx scripts/import-nutricare-v0.ts",
		"db:dedupe-sessions": "tsx scripts/dedupe-meal-plan-sessions.ts",
		"db:clear": "tsx scripts/clear-data.ts",
		"db:clear-supabase": "node --env-file=.env --import tsx scripts/clear-supabase-data.ts",
		"db:flush-supabase": "node --env-file=.env --import tsx scripts/flush-supabase-public.ts",
		"db:test-storage-sync": "node --env-file=.env --import tsx scripts/test-sqlite-storage-sync.ts",
		"db:drop": "tsx scripts/hard-reset-db.ts",
		"db:seed": "tsx scripts/seed.ts",
		"db:seed-demo-journey": "tsx scripts/seed-demo-dietitian-journey.ts",
		"db:verify-seed": "tsx scripts/verify-seeds.ts",
		"db:reset": "npm run db:clear && npm run db:seed",
		"db:hard-reset": "npm run db:drop && npm run db:push:force && npm run db:seed",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"start": "node build/index.js"
	},
	"dependencies": {
		"bcryptjs": "^3.0.3",
		"better-sqlite3": "^12.8.0",
		"chart.js": "^4.5.1",
		"drizzle-kit": "^0.31.8",
		"drizzle-orm": "^0.45.1",
		"pg": "^8.20.0",
		"resend": "^6.10.0",
		"uuid": "9.0.1",
		"tsx": "^4.21.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-node": "^5.5.2",
		"@sveltejs/adapter-vercel": "^5.10.3",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@types/bcryptjs": "^2.4.6",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^22",
		"@types/pg": "^8.20.0",
		"@vitest/coverage-v8": "^4.1.3",
		"eslint": "^10.0.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.2",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.0",
		"vite": "^7.3.1",
		"vitest": "^4.1.3"
	},
	"overrides": {
		"uuid": "9.0.1"
	}
}
